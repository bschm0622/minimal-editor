{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minimal-editor",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "editor.beckyschmidt.me", "custom_domain": true }
  ]
}
